# GGOO 统一账户与计费网关。Build 不保存用户模型 Key。
GGOO_API_BASE_URL=https://api.ggoo.ai
GGOO_GATEWAY_BASE_URL=https://api.ggoo.ai/v1
GGOO_MODEL=auto
# 仅供离线评测脚本使用；Web 请求始终使用当前登录用户自己的 GGOO Key。
GGOO_SERVICE_API_KEY=
# 本地旧账号只用于迁移或自动化测试，生产必须保持 false。
BUILD_LEGACY_AUTH_ENABLED=false
# 前端允许跨域来源，生产填正式域名，多个用英文逗号分隔
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 数据库地址，默认本地 SQLite 文件
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
