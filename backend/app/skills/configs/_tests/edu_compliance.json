{
  "skill_key": "edu_compliance",
  "cases": [
    {
      "id": "red-1",
      "input": {
        "module": "edu_compliance",
        "facts": {"单次收费时长": "12个月", "预收金额": "1.2万", "存管账户余额": "0", "未消课时对应金额": "9万"},
        "pains": ["搞了个一年优惠活动一次性收了一年学费", "钱都用在运营上了"]
      },
      "expected_signal": "red",
      "expect_data_requests": false,
      "assertions": ["conclusion 含 单次收费时长 或 存管 或 资金缺口", "至少一条 action 含 暂停/整改/补存/拆分/退还 之一", "evidence 引用 12个月 或 3个月 或 0 或 9万 这些数字"]
    },
    {
      "id": "red-2",
      "input": {
        "module": "edu_compliance",
        "facts": {"办学许可证": "无", "营业执照经营范围": "教育咨询", "实际授课": "小学数学/语文"},
        "pains": ["一直没办下来许可证就开课了", "怕被查"]
      },
      "expected_signal": "red",
      "expect_data_requests": false,
      "assertions": ["conclusion 命中 无证办学 或 办学许可证", "至少一条 action 含 暂停/整改/重新登记 之一", "evidence 含 5万 或 50万 罚款区间且注明来源"]
    },
    {
      "id": "red-3",
      "input": {
        "module": "edu_compliance",
        "facts": {"机构类型": "学科类", "暑假排课": "小学英语每周3次", "授课对象": "义务教育阶段学生"},
        "pains": ["暑假悄悄上英语觉得查不到", "有家长开始拍照"]
      },
      "expected_signal": "red",
      "expect_data_requests": false,
      "assertions": ["conclusion 命中 节假日 或 寒暑假 或 学科类违规排课", "至少一条 action 含 暂停/下架 之一", "evidence 引用 暑假 或 义务教育"]
    },
    {
      "id": "red-4",
      "input": {
        "module": "edu_compliance",
        "facts": {"单次收费课时数": "80课时", "存管比例": "0%", "退费执行率": "30%"},
        "pains": ["课时包卖得多收得猛", "退费一直拖"]
      },
      "expected_signal": "red",
      "expect_data_requests": false,
      "assertions": ["conclusion 命中 单次收费课时数 或 存管 或 退费执行率", "至少一条 action 含 暂停/补存/退还 之一", "evidence 引用 80课时 或 60课时 或 0% 或 30%"]
    },
    {
      "id": "red-5",
      "input": {
        "module": "edu_compliance",
        "facts": {"广告语": "保过提分30分", "教师持证率": "20%", "机构类型": "学科类"},
        "pains": ["招生靠保过广告", "老师大多只有行业证书"]
      },
      "expected_signal": "red",
      "expect_data_requests": false,
      "assertions": ["conclusion 命中 教师持证率 或 广告", "至少一条 action 含 下架/整改/核验 之一", "evidence 引用 保过 或 提分30分 或 20%"]
    },
