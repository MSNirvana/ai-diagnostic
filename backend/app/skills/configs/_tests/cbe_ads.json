    {
      "id": "red-1",
      "input": {
        "module": "cbe_ads",
        "facts": {"平台": "亚马逊", "ACOS": "44%", "毛利率": "40%", "广告CVR": "6%", "Listing阶段": "成熟"},
        "pains": ["广告越投越亏", "出价提了也没用"]
      },
      "expected_signal": "red",
      "expect_data_requests": false,
      "assertions": ["conclusion 含 ACOS 或 CVR", "至少一条 action 含 暂停/改写/重建/下调/重分/拆分 之一", "evidence 引用 44 或 6 这些输入数字"]
    },
