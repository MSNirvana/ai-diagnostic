{
  "skill_key": "dtc_ads",
  "cases": [
    {
      "id": "red-1",
      "input": {
        "module": "dtc_ads",
        "facts": {"ROAS": "1.2", "毛利率": "35%", "CAC": "180", "客单价": "210", "复购率": "12%"},
        "pains": ["投放越来越贵", "感觉在给平台打工"]
      },
      "expected_signal": "red",
      "expect_data_requests": false,
      "assertions": ["conclusion 含 ROAS 或 CAC 或 毛利", "至少一条 action 含强动作动词", "evidence 引用输入数字"]
    },
    {
      "id": "red-2",
      "input": {
        "module": "dtc_ads",
        "facts": {"CTR": "0.8%", "转化率": "0.6%", "CAC": "260", "客单价": "150"},
        "pains": ["点击不少但成交很差"]
      },
      "expected_signal": "red",
      "expect_data_requests": false,
      "assertions": ["conclusion 命中行业KPI", "action 可执行"]
    },
    {
      "id": "yellow-1",
      "input": {
        "module": "dtc_ads",
        "facts": {"ROAS": "2.1", "毛利率": "55%", "复购率": "28%"},
        "pains": ["想扩量但怕亏"]
      },
      "expected_signal": "yellow",
      "expect_data_requests": false,
      "assertions": ["conclusion 命中行业KPI"]
    },
    {
      "id": "green-1",
      "input": {
        "module": "dtc_ads",
        "facts": {"ROAS": "3.5", "毛利率": "62%", "CAC": "90", "客单价": "320", "复购率": "41%"},
        "pains": ["想知道还能不能更好"]
      },
      "expected_signal": "green",
      "expect_data_requests": false,
      "assertions": ["结论基调不全是负面"]
    },
    {
      "id": "missing-1",
      "input": {
        "module": "dtc_ads",
        "facts": {},
        "pains": ["投放效果不好"]
      },
      "expected_signal": "yellow",
      "expect_data_requests": true,
      "assertions": ["data_requests 非空", "confidence < 0.5"]
    },
    {
      "id": "missing-2",
      "input": {
        "module": "dtc_ads",
        "facts": {"主投平台": "千川"},
        "pains": ["想优化投放结构"]
      },
      "expected_signal": "yellow",
      "expect_data_requests": true,
      "assertions": ["data_requests 含 campaign_performance 或 order_economics"]
    }
  ]
}
